{
  "name": "vesta",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:services": "concurrently --kill-others --names API,WEB --prefix-colors blue,green \"npm:dev:server\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "release:all": "node scripts/release-all.mjs",
    "typecheck": "tsc -b && tsc -p apps/server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-database-integration.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:performance && cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
