NODE_ENV=development
DEPLOYMENT_MODE=self-hosted
PORT=3000
DATABASE_URL=postgres://localhost/vesta
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost
RESEND_API_KEY=
EMAIL_FROM=
ENABLE_CONSOLE_PASSWORD_RESET=false

# Attachments use a local filesystem directory by default in self-hosted mode.
# Set an absolute writable path for production deployments.
ATTACHMENT_STORAGE_BACKEND=filesystem
ATTACHMENT_STORAGE_DIRECTORY=

# Cloud deployments must use S3. The AWS SDK uses its standard credential chain
# (for example, an IAM role); never put AWS credentials in the browser.
# ATTACHMENT_STORAGE_BACKEND=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=vesta-attachments
# AWS_S3_ENDPOINT=https://s3.example.test
# AWS_S3_FORCE_PATH_STYLE=false

# For an explicitly trusted self-hosted development server only:
# ENABLE_CONSOLE_PASSWORD_RESET=true

# Required when building the packaged desktop app. Use an HTTPS origin in production:
# VITE_API_URL=http://localhost:3000

# Optional version displayed by the web and desktop apps; defaults to package.json:
# VITE_APP_VERSION=1.2.3
