NODE_ENV=development
DEPLOYMENT_MODE=self-hosted
PORT=3000
DATABASE_URL=postgres://localhost/vesta
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost
RESEND_API_KEY=
EMAIL_FROM=
ENABLE_CONSOLE_PASSWORD_RESET=false

# For an explicitly trusted self-hosted development server only:
# ENABLE_CONSOLE_PASSWORD_RESET=true

# Required when building the packaged desktop app. Use an HTTPS origin in production:
# VITE_API_URL=http://localhost:3000
